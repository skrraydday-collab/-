body{
font-family: Arial;
background:#f5f5f5;
margin:0;
text-align:center;
}

header{
background:#0b8f4d;
color:white;
padding:20px;
}

input{
width:90%;
padding:12px;
margin:15px;
border-radius:10px;
border:1px solid #ccc;
}

.grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:20px;
}

button{
padding:18px;
border:none;
border-radius:15px;
background:white;
font-size:18px;
}
